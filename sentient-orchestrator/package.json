{
  "name": "sentient-orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:worker": "tsx src/worker.ts",
    "dev:worker:automatic": "tsx src/automatic-worker.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "worker:automatic": "tsx src/automatic-worker.ts",
    "migrate": "tsx src/migrate.ts",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
