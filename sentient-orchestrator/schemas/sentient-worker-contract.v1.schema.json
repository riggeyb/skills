{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentient.dev/schemas/worker-contract/1.0",
  "title": "Sentient Worker Contract v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "workerId",
    "taskId",
    "tenantId",
    "repositoryId",
    "role",
    "objective",
    "assignment",
    "constraints",
    "dependencies",
    "capabilities",
    "authority",
    "resourceClaims",
    "budget",
    "allowedTools",
    "modelRuntimeRequirements",
    "completionCriteria",
    "reportingRequirements"
  ],
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "workerId": {
      "type": "string",
      "minLength": 1
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "parentWorkerId": {
      "type": "string",
      "minLength": 1
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "repositoryId": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "assignment": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "$ref": "#/$defs/strings"
    },
    "dependencies": {
      "$ref": "#/$defs/strings"
    },
    "capabilities": {
      "$ref": "#/$defs/strings"
    },
    "authority": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "repository:read",
          "repository:write",
          "branch:create",
          "commit",
          "push",
          "issue:comment",
          "checks:read",
          "checks:write",
          "pr:create",
          "secrets:access",
          "sandbox:execute",
          "workers:spawn",
          "workers:cancel",
          "merge"
        ]
      }
    },
    "resourceClaims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resourceClaim"
      }
    },
    "branch": {
      "type": "string"
    },
    "workspace": {
      "type": "string"
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deadline": {
      "type": "string",
      "format": "date-time"
    },
    "allowedTools": {
      "$ref": "#/$defs/strings"
    },
    "modelRuntimeRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiredCapabilities": {
          "$ref": "#/$defs/strings"
        },
        "prohibitedProviders": {
          "$ref": "#/$defs/strings"
        },
        "notes": {
          "$ref": "#/$defs/strings"
        }
      }
    },
    "completionCriteria": {
      "$ref": "#/$defs/strings"
    },
    "reportingRequirements": {
      "$ref": "#/$defs/strings"
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resourceClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceType",
        "resourceId",
        "mode",
        "ownerWorkerId",
        "taskId",
        "tenantId",
        "leaseId",
        "acquiredAt",
        "expiresAt"
      ],
      "properties": {
        "resourceType": {
          "enum": [
            "file",
            "directory",
            "database-migration",
            "api-interface",
            "task",
            "test-suite",
            "artifact"
          ]
        },
        "resourceId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "exclusive",
            "shared"
          ]
        },
        "ownerWorkerId": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "tenantId": {
          "type": "string",
          "minLength": 1
        },
        "leaseId": {
          "type": "string",
          "minLength": 1
        },
        "acquiredAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "releasedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
