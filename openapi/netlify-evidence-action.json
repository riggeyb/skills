{
  "openapi": "3.1.0",
  "info": {
    "title": "Netlify Deploy Evidence",
    "description": "Read-only Netlify deploy/build evidence for exact-SHA verification.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.netlify.com/api/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/sites": {
      "get": {
        "operationId": "listNetlifySites",
        "summary": "List Netlify sites",
        "description": "List sites visible to the authenticated token.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      },
                      "ssl_url": {
                        "type": "string"
                      },
                      "build_settings": {
                        "type": "object",
                        "properties": {
                          "repo_url": {
                            "type": "string"
                          },
                          "repo_path": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sites/{site_id}/deploys": {
      "get": {
        "operationId": "listNetlifySiteDeploys",
        "summary": "List site deploys",
        "description": "List deploys for one site.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deploy-previews",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "production",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "branch",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest-published",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deploys",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Deploy"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sites/{site_id}/deploys/{deploy_id}": {
      "get": {
        "operationId": "getNetlifySiteDeploy",
        "summary": "Read one deploy",
        "description": "Read one deploy by deploy ID.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "site_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deploy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deploy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Deploy"
                }
              }
            }
          }
        }
      }
    },
    "/builds/{build_id}": {
      "get": {
        "operationId": "getNetlifySiteBuild",
        "summary": "Read one build",
        "description": "Read one build by build ID.",
        "x-openai-isConsequential": false,
        "parameters": [
          {
            "name": "build_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Build",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "deploy_id": {
                      "type": "string"
                    },
                    "sha": {
                      "type": "string"
                    },
                    "done": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "id",
                    "deploy_id",
                    "sha",
                    "done"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Deploy": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "site_id": {
            "type": "string"
          },
          "build_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "deploy_url": {
            "type": "string"
          },
          "deploy_ssl_url": {
            "type": "string"
          },
          "review_url": {
            "type": "string"
          },
          "branch": {
            "type": "string"
          },
          "commit_ref": {
            "type": "string"
          },
          "error_message": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "site_id",
          "build_id",
          "state"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
